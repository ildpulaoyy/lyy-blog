---
import { withBase } from "../lib/urls";
import BlogLayout from "../layouts/BlogLayout.astro";
import { personalInfo } from "../config";
---
<BlogLayout title="关于" heroTitle="你好，我是青椒" heroSubtitle="来自青椒星球的一只青椒，认真记录生活。">
  <section class="card page-card about-card">
    <div class="about-intro"><img src={personalInfo.avatar} width="90" height="90" alt="青椒" /><div><span class="eyebrow">HELLO, I'M QINGJIAO</span><h2>很高兴，和你相遇 <span class="accent">✿</span></h2><p>来自青椒星球 / 热爱记录 / 保持好奇</p></div></div>
    <div class="prose">
      <h2>关于我</h2>
      <p>你好，我是青椒，你也可以叫我 im lyy。喜欢把日常写下来——日记、随笔、摘抄，还有一些没什么道理的胡言乱语。</p>
      <p>这里是我的个人博客，从原来的 Hexo 小站迁移而来。不追求每篇文章都面面俱到，只希望真实地留下生活最原本的样子。</p>
      <blockquote><p>遇到艰难险阻的时候，我常会想起这个世界怎么还不毁灭。——青椒</p></blockquote>
      <h2>正在折腾什么</h2>
    </div>
    <div class="interest-grid"><div><span class="icon-[lucide--code-xml]" aria-hidden="true"></span><strong>写一点代码</strong><p>Astro、Vue、TypeScript<br />把灵感变成小小的作品</p></div><div><span class="icon-[lucide--coffee]" aria-hidden="true"></span><strong>过一点生活</strong><p>音乐、散步、碎碎念<br />收藏平凡日子里的亮光</p></div></div>
    <div class="prose">
      <h2>关于这个小站</h2>
      <p>这个小站使用 Kanade 主题构建，粉色、圆角、轻轻流动的波浪，是想留给每位访客的一点温柔。</p>
      <p>小站基于 Astro、Vue 与 Tailwind CSS，这里收藏着我从 2022 年至今的日记与随笔。</p>
      <h2>关于这里的内容</h2>
      <p>这里的每一篇都是我真实写下的文字，串联起来，就是这几年的我。谢谢你的阅读。</p>
    </div>
    <div class="about-links"><a class="btn" href={personalInfo.github} target="_blank" rel="noopener noreferrer"><span class="icon-[jam--github]" aria-hidden="true"></span>GitHub</a><a class="btn secondary" href={withBase("/posts/")}>读读我的文章<span class="icon-[lucide--arrow-right]" aria-hidden="true"></span></a></div>
    <div class="about-end">谢谢你，在互联网的某个角落找到了这里。<span>✿</span></div>
  </section>
</BlogLayout>
<style>
.about-intro { display: flex; align-items: center; gap: 22px; }
.about-intro img { border-radius: 26px; transform: rotate(-4deg); box-shadow: 5px 5px 0 var(--accent-soft); }
.about-intro .eyebrow { font-size: 9px; }
.about-intro h2 { font-size: 23px; margin: 7px 0; }
.about-intro p { color: var(--muted); font-size: 11px; margin: 0; }
.interest-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.interest-grid > div { border-radius: 12px; background: var(--accent-soft); padding: 20px; }
.interest-grid span { color: var(--accent); font-size: 25px; display: block; margin-bottom: 13px; }
.interest-grid strong { font-size: 14px; font-weight: 400; }
.interest-grid p { font-size: 11px; line-height: 2; color: var(--muted); margin-bottom: 0; }
.about-links { display: flex; flex-wrap: wrap; gap: 12px; margin: 25px 0; font-size: 12px; }
.about-end { text-align: center; border-top: 1px dashed var(--line); margin-top: 32px; padding-top: 25px; color: var(--muted); font-size: 11px; }
.about-end span { display:block; font-size: 22px; color: var(--accent); margin-top: 10px; }
@media(max-width:480px) { .about-intro { flex-direction: column; text-align: center; } .about-intro h2 { font-size: 21px; } .interest-grid { gap: 10px; } .interest-grid > div { padding: 15px; } }
</style>